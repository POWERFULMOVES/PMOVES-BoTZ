# Shared environment variables for PMOVES Pro Pack
# This file contains environment variables shared across services

# TensorZero Gateway (centralized LLM routing)
TENSORZERO_URL=${TENSORZERO_URL:-http://tensorzero:3030}
TENSORZERO_CHAT_MODEL=${TENSORZERO_CHAT_MODEL:-qwen2_5_14b}
TENSORZERO_EMBED_MODEL=${TENSORZERO_EMBED_MODEL:-gemma_embed_local}

# API Keys (inherited from root .env - used by TensorZero)
OPENAI_API_KEY=${OPENAI_API_KEY}
VENICE_API_KEY=${VENICE_API_KEY}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
GROQ_API_KEY=${GROQ_API_KEY}
GEMINI_API_KEY=${GEMINI_API_KEY}
OLLAMA_BASE_URL=${OLLAMA_BASE_URL}
CIPHER_API_PORT=${CIPHER_API_PORT}
CIPHER_UI_PORT=${CIPHER_UI_PORT}
CIPHER_ENCRYPTION_KEY=${CIPHER_ENCRYPTION_KEY}

# Service Configuration
TAILSCALE_AUTHKEY=${TAILSCALE_AUTHKEY}
E2B_API_KEY=${E2B_API_KEY}

# Database Configuration
POSTGRES_HOSTNAME=${POSTGRES_HOSTNAME}
POSTGRES_PORT=${POSTGRES_PORT}
POSTGRES_DB=${POSTGRES_DB}
SERVICE_USER_ADMIN=${SERVICE_USER_ADMIN}
SERVICE_PASSWORD_ADMIN=${SERVICE_PASSWORD_ADMIN}

# Supabase Configuration
SUPABASE_URL=${SUPABASE_URL}
SUPABASE_KEY=${SUPABASE_KEY}
SUPABASE_SERVICE_KEY=${SUPABASE_SERVICE_KEY}
SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}

# Additional Service Configuration
POSTMAN_API_KEY=${POSTMAN_API_KEY}
N8N_API_KEY=${N8N_API_KEY}
N8N_RUNNERS_AUTH_TOKEN=${N8N_RUNNERS_AUTH_TOKEN}

# CHIT (Cognitive Holographic Information Transfer) - Inherited from parent
CHIT_REQUIRE_SIGNATURE=${CHIT_REQUIRE_SIGNATURE}
CHIT_PASSPHRASE=${CHIT_PASSPHRASE}
CHIT_DECRYPT_ANCHORS=${CHIT_DECRYPT_ANCHORS}
CHIT_DECODE_TEXT=${CHIT_DECODE_TEXT}
CHIT_DECODE_IMAGE=${CHIT_DECODE_IMAGE}
CHIT_DECODE_AUDIO=${CHIT_DECODE_AUDIO}
CHIT_CODEBOOK_PATH=${CHIT_CODEBOOK_PATH}
CHIT_T5_MODEL=${CHIT_T5_MODEL}
CHIT_CLIP_MODEL=${CHIT_CLIP_MODEL}
CHIT_PERSIST_DB=${CHIT_PERSIST_DB}

# PMOVES Root Directory (required by MCP catalog)
PMOVES_ROOT=/app
