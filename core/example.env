# ===== PMOVES Consolidated Environment Configuration =====
# This file contains all environment variables used across agent packs.
# Copy to .env and fill in your values.
# Variables are grouped by pack usage.

# ===== COMMON (All Packs) =====
# Postman API integration
POSTMAN_API_KEY=
POSTMAN_API_BASE_URL=https://api.postman.com

# Tailscale for remote access (Mini, Multi, Pro)
TS_AUTHKEY=

# ===== MINI PACK ONLY =====
# Branding / channels
SLACK_CHANNEL=#cataclysm-deploys
DOCS_LOG_CHANNEL=#cataclysm-deploys

# Notifiers
SLACK_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Crush MCP
CRUSH_API_KEY=
CRUSH_PORT=7069

# Hostinger / deploy
HOSTINGER_API_KEY=
HOSTINGER_PROJECT_ID=
HOSTINGER_ENV=staging

# n8n / runners
N8N_RUNNERS_AUTH_TOKEN=

# Core services
HIRAG_URL=http://hi-rag-gateway-v2-gpu:8086
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=
QDRANT_URL=http://qdrant:6333
NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false

# UI / Playwright
PLAYWRIGHT_BASE_URL=https://staging.example.com

# ===== PRO PACK ONLY =====
# E2B Sandbox
E2B_API_KEY=
SANDBOX_TTL_SEC=1800

# ===== TensorZero Gateway (PMOVES-Compatible) =====
# All LLM calls should route through TensorZero for:
# - Unified API (OpenAI-compatible)
# - Observability via ClickHouse
# - Cost tracking and rate limiting
TENSORZERO_URL=http://tensorzero:3030

# Chat model (maps to tensorzero.toml [models.*])
# Available: qwen2_5_32b, qwen2_5_14b, claude_sonnet, gpt4o, etc.
TENSORZERO_CHAT_MODEL=qwen2_5_14b

# Embedding model (maps to tensorzero.toml [models.*])
# Available: gemma_embed_local, nomic_embed_local, openai_embed_small
TENSORZERO_EMBED_MODEL=gemma_embed_local

# Vision-Language model (via TensorZero)
TENSORZERO_VL_MODEL=qwen2_vl_7b

# Legacy direct Ollama access (use TensorZero instead when possible)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Agent Zero Model (routed via TensorZero)
# Maps to: ${TENSORZERO_URL}/v1/chat/completions with model=${TENSORZERO_CHAT_MODEL}
AGENT_ZERO_MODEL=qwen2_5_14b

# Archon Embedding Model (routed via TensorZero)
# Maps to: ${TENSORZERO_URL}/v1/embeddings with model=${TENSORZERO_EMBED_MODEL}
ARCHON_EMBEDDING_MODEL=gemma_embed_local


# ===== Cipher (Required) =====
VENICE_API_KEY=
CIPHER_API_PORT=3011
CIPHER_UI_PORT=3010
# 64 hex chars; MUST be unique per deployment. Example (do NOT use as‑is): `openssl rand -hex 32`
CIPHER_ENCRYPTION_KEY=CHANGE_ME_GENERATE_64_HEX_CHARS

# ===== PRO PLUS PACK ONLY =====
# Slack CI reporting
SLACK_WEBHOOK_URL=
