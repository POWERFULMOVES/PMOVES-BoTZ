# PMOVES-BoTZ Hybrid Standalone Mode Configuration
# Run BoTZ independently while optionally connecting to PMOVES.AI services

# =============================================================================
# MODE DETECTION
# =============================================================================
# Set to false when running standalone (independent Docker Compose)
# Set to true when running as part of PMOVES.AI docker-compose
DOCKED_MODE=false
PARENT_SYSTEM=PMOVES.AI

# =============================================================================
# TENSORZERO GATEWAY (Optional - for LLM features)
# =============================================================================
# TensorZero Gateway provides centralized LLM orchestration
# Leave empty to use local Ollama or direct provider APIs

# Primary TensorZero URL (used in hybrid standalone mode)
TENSORZERO_URL=http://host.docker.internal:3030

# TensorZero API key (if authentication is enabled)
TENSORZERO_API_KEY=

# Default chat model (orchestrator function)
TENSORZERO_CHAT_MODEL=orchestrator

# Default embedding model
TENSORZERO_EMBED_MODEL=embed

# Default utility model (fast operations)
TENSORZERO_UTILITY_MODEL=utility

# =============================================================================
# PMOVES.AI SERVICES (Optional - Hybrid Mode)
# =============================================================================
# These services are available when running in hybrid mode with parent PMOVES.AI

# Hi-RAG Gateway v2 (Hybrid RAG - vectors + graph + full-text)
HIRAG_URL=http://host.docker.internal:8086

# SupaSerch (Multimodal holographic deep research)
SUPASERCH_URL=http://host.docker.internal:8099

# NATS Message Bus (Event coordination)
NATS_URL=nats://nats:pmoves@host.docker.internal:4222

# Supabase (Database storage)
SUPABASE_URL=http://host.docker.internal:3010
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# =============================================================================
# OLLAMA (Local LLM - Optional)
# =============================================================================
# Ollama provides local LLM inference as fallback when TensorZero unavailable
# Used by VL Sentinel for vision-language tasks

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_PORT=11434

# VL Sentinel configuration
VL_PROVIDER=ollama
VL_MODEL=llava

# =============================================================================
# DOCUMENT PROCESSING
# =============================================================================
# Docling VLM for advanced document understanding (figures, charts, tables)
DOCLING_VLM_REPO=ibm-granite/granite-docling-258m-demo

# HuggingFace API key for model downloads
HF_API_KEY=

# =============================================================================
# CODE EXECUTION
# =============================================================================
# E2B Sandbox for secure code execution
E2B_API_KEY=

# =============================================================================
# MEMORY & REASONING
# =============================================================================
# Venice API for Cipher Memory LLM operations
VENICE_API_KEY=

# =============================================================================
# SERVICE PORTS
# =============================================================================
# Override default ports if needed for your environment
GATEWAY_PORT=2091
MCP_BRIDGE_PORT=8100
DOCLING_PORT=3020
E2B_PORT=7071
CIPHER_PORT=8081
VL_PORT=7072
OLLAMA_PORT=11434
METRICS_PORT=9091

# =============================================================================
# MONITORING
# =============================================================================
# Prometheus Pushgateway for metrics export
PROMETHEUS_PUSHGATEWAY=http://host.docker.internal:9091

# =============================================================================
# NOTES
# =============================================================================
#
# Fully Standalone Mode (No PMOVES.AI):
#   1. Start Ollama for local LLM: docker compose --profile ollama up -d
#   2. Start core services: docker compose up -d
#   3. Optional tools: docker compose --profile tools up -d
#
# Hybrid Mode (With PMOVES.AI services):
#   1. Keep TENSORZERO_URL=http://host.docker.internal:3030
#   2. Ensure PMOVES.AI is running: cd /home/pmoves/PMOVES.AI && docker compose up -d
#   3. Start BoTZ: docker compose up -d
#   4. Verify connectivity: docker exec pmoves-botz-gateway curl http://host.docker.internal:3030/healthz
#
# Enable All Services:
#   docker compose --profile cipher --profile e2b --profile ollama --profile tools up -d
#
# For Linux hosts, ensure host.docker.internal works:
#   docker compose --add-host=host.docker.internal:host-gateway up -d
